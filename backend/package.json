{
  "name": "snackify-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Snackify REST API (Express + TypeScript)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:watch": "vitest --project unit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:db",
    "db:migrate": "tsx src/scripts/migrate.ts up",
    "db:rollback": "tsx src/scripts/migrate.ts down",
    "db:seed": "tsx src/scripts/seed.ts",
    "user:create": "tsx src/scripts/create-user.ts",
    "db:new-migration": "node-pg-migrate create --migrations-dir ../database/migrations --migration-file-language sql --migration-filename-format utc"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@zxing/library": "^0.23.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  }
}
