# Copy this file to .env (in the backend folder) and adjust for your machine.
# Never commit .env. Never put real production credentials in this example file.

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=3000

# Comma-separated browser origins allowed to call the API (no wildcards, no trailing slash).
# Matches the Flutter web dev server started with: flutter run -d chrome --web-port 8080
CORS_ORIGINS=http://localhost:8080

# --- Stage 2 (not used yet) ---
# PostgreSQL connection for local development. Use a dedicated development database and user.
# DATABASE_URL=postgres://snackify_dev:change-me@localhost:5432/snackify_dev
