# Copy this file to .env (in the backend folder) and adjust for your machine.
# Never commit .env. Never put real production credentials in this example file.

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=3000

# Comma-separated browser origins allowed to call the API (no wildcards, no trailing slash).
# Matches the Flutter web dev server started with: flutter run -d chrome --web-port 8080
CORS_ORIGINS=http://localhost:8080

# PostgreSQL. Roles and databases are created by database/setup/local-setup.sql;
# use the same two passwords you gave that script.
# The API connects as snackify_app (read/write data only); migrations run as snackify_owner.
DATABASE_URL=postgres://snackify_app:CHANGE_ME_APP_PASSWORD@localhost:5432/snackify_dev
MIGRATION_DATABASE_URL=postgres://snackify_owner:CHANGE_ME_OWNER_PASSWORD@localhost:5432/snackify_dev

# Separate database for automated tests (npm run test:db). Its data is wiped by the tests.
TEST_DATABASE_URL=postgres://snackify_app:CHANGE_ME_APP_PASSWORD@localhost:5432/snackify_test
TEST_MIGRATION_DATABASE_URL=postgres://snackify_owner:CHANGE_ME_OWNER_PASSWORD@localhost:5432/snackify_test
