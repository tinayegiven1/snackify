# Copy this file to .env (in the backend folder) and adjust for your machine.
# Never commit .env. Never put real production credentials in this example file.

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=3000

# Comma-separated browser origins allowed to call the API (no wildcards, no trailing slash).
# Matches the Flutter web dev server started with: flutter run -d chrome --web-port 8080
CORS_ORIGINS=http://localhost:8080

# PostgreSQL. Roles and databases are created by database/setup/local-setup.sql;
# use the same two passwords you gave that script.
# The API connects as snackify_app (read/write data only); migrations run as snackify_owner.
DATABASE_URL=postgres://snackify_app:CHANGE_ME_APP_PASSWORD@localhost:5432/snackify_dev
MIGRATION_DATABASE_URL=postgres://snackify_owner:CHANGE_ME_OWNER_PASSWORD@localhost:5432/snackify_dev

# Separate database for automated tests (npm run test:db). Its data is wiped by the tests.
TEST_DATABASE_URL=postgres://snackify_app:CHANGE_ME_APP_PASSWORD@localhost:5432/snackify_test
TEST_MIGRATION_DATABASE_URL=postgres://snackify_owner:CHANGE_ME_OWNER_PASSWORD@localhost:5432/snackify_test

# Business settings (all optional; the defaults are shown).
# Time zone that decides "today" for business dates and billing weeks.
# BUSINESS_TIMEZONE=Africa/Harare
# First day of the weekly billing period (monday ... sunday). With monday, the default period is
# the last complete Monday-to-Sunday week.
# BILLING_WEEK_STARTS_ON=monday
# Currency of all prices and invoices (three-letter ISO code).
# BASE_CURRENCY=USD
# Days after the issue date that an invoice is due (0-365). Used for overdue balances.
# PAYMENT_TERMS_DAYS=7
# Printed at the top of invoice PDFs. The contact line is optional (address, phone, email).
# BUSINESS_NAME=Snackify
# BUSINESS_CONTACT=12 Example Road, Harare · +263 00 000 0000

# Backups (all optional; see docs/backup-and-restore.md). npm run db:backup backs up the
# MIGRATION_DATABASE_URL database and test-restores it into snackify_restore_check.
# BACKUP_DIR=C:\dev\snackify\backups
# BACKUP_KEEP=30
# Folder with pg_dump and pg_restore (found automatically for the standard Windows install).
# PG_BIN_DIR=C:\Program Files\PostgreSQL\18\bin
# Scratch database for restore checks; it is wiped every time, so its name must end in _restore_check.
# RESTORE_CHECK_DATABASE_URL=postgres://snackify_owner:CHANGE_ME_OWNER_PASSWORD@localhost:5432/snackify_restore_check

# Goods-received notes (StockFlow Stage 4; all optional, the defaults are shown).
# true: a receipt's stock can be used as soon as it is submitted, and is taken back out if the
# reviewer rejects it. false: stock is added only after verification ("Post stock").
# RECEIPT_STOCK_AVAILABLE_BEFORE_VERIFICATION=true
# true: a receipt needs at least one supplier document (PDF, JPEG or PNG) before submitting,
# unless a user with receipt.no_document gives a reason.
# RECEIPT_DOCUMENT_REQUIRED=true
# Largest document accepted, in bytes (1 KB to 50 MB; default 10 MB).
# ATTACHMENT_MAX_BYTES=10485760
# Folder for uploaded documents (default: storage/attachments in the repository). Keep it
# outside WEB_APP_DIR and back it up with the database: the files are business records.
# ATTACHMENT_STORAGE_DIR=C:\dev\snackify\storage\attachments
